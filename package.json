{
  "name": "beldex-electron-wallet",
  "version": "7.0.1",
  "description": "Modern GUI interface for Beldex Currency",
  "productName": "Beldex Electron Wallet",
  "repository": {
    "type": "git",
    "url": "https://github.com/Beldex-coin/beldex-electron-gui-wallet.git"
  },
  "cordovaId": "com.beldex.wallet",
  "author": {
    "name": "Beldex",
    "email": "support@beldex.io"
  },
  "private": true,
  "scripts": {
    "dev": "quasar dev -m electron",
    "build": "quasar build -m electron --publish=never",
    "release": "quasar build -m electron --publish=always",
    "lint": "eslint --fix .",
    "format": "prettier --write \"**/*.+(js|jsx|json|yml|yaml|css|md|vue)\"",
    "ready": "npm run lint && npm run format"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "bunyan": "^1.8.14",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "fs-extra": "^11.3.5",
    "https": "^1.0.0",
    "object-assign-deep": "^0.4.0",
    "portscanner": "^2.2.0",
    "promise-queue": "^2.2.5",
    "qrcode.vue": "^1.7.0",
    "quasar": "1.22.10",
    "semver": "^7.3.2",
    "upath": "^3.0.7",
    "vue-i18n": "^8.28.2",
    "vue-timeago": "^5.1.2",
    "vuelidate": "^0.7.4"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@quasar/app": "2.4.4",
    "@quasar/extras": "^1.9.4",
    "autoprefixer": "^9.8.8",
    "babel-eslint": "^10.1.0",
    "devtron": "^1.4.0",
    "dotenv": "^17.4.2",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "electron-debug": "^2.1.0",
    "electron-devtools-installer": "^2.2.4",
    "eslint": "^5.16.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-loader": "^2.2.1",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-vue": "^5.2.3",
    "husky": "^4.2.3",
    "lint-staged": "^10.0.8",
    "prettier": "^1.19.1",
    "sass": "1.32.12",
    "sass-loader": "7.3.1",
    "strip-ansi": "^3.0.1",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vue-template-compiler": "^2.7.16",
    "vuex": "^3.6.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.+(js|jsx|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.+(json|yml|yaml|css|md)": "prettier --write"
  },
  "engines": {
    "node": ">= 24.15.0 < 25",
    "npm": ">= 5.6.0",
    "yarn": ">= 1.6.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}
