}
.q-header .q-btn.menu {
  height: 37px;
  width: 37px;
  position: absolute;
  top: 0;
  z-index: 1;
  border-radius: 0;
}
.q-header .q-btn.cancel {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}
.q-header .q-toolbar-inverted {
  background: #1c1c26;
