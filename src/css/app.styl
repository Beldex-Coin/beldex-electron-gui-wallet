// app global css
@import "quasar.variables"
@import "flags"

// ---------------------------------------------------------------------------
// Design tokens
// ---------------------------------------------------------------------------
// Values follow the designer's "Beldex Terminal · v2" design system
// (Figma node 445:3 + Beldex_Wallet_Design_System.md).
//
// Defined as CSS custom properties so `<style lang="scss">` and plain
// `<style>` component blocks can use them via var(--beldex-*).

// Brand faces (designer hand-off, SIL Open Font License). Latin + Latin-1
// subsets with a variable wght axis; Cyrillic (ru) and a few symbols (≈ → ←)
// fall back per glyph to the faces listed after them in the tokens below.
// Unique family names so a locally installed copy is never picked up.
@font-face {
  font-family: "Beldex Roboto Mono";
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("~assets/fonts/RobotoMono-Latin.var.woff2") format("woff2");
}

@font-face {
  font-family: "Beldex Inter";
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("~assets/fonts/Inter-Latin.var.woff2") format("woff2");
}

// Same file pinned to 500, so --beldex-font-sans-medium works as a family
// token like the Poppins-Medium face it replaces.
@font-face {
  font-family: "Beldex Inter Medium";
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url("~assets/fonts/Inter-Latin.var.woff2") format("woff2");
}

@font-face {
  font-family: "Beldex JetBrains Mono";
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("~assets/fonts/JetBrainsMono-Latin.var.woff2") format("woff2");
}

// Display face (Conthrax SemiBold) for headings and large figures, reached
// through --beldex-font-display. Body text stays on Inter / Roboto Mono.
@font-face {
  font-family: "Beldex Conthrax";
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url("~assets/fonts/Conthrax-SemiBold.ttf") format("truetype");
}

:root {
  // Surfaces
  --beldex-bg: #0b0b0b;
  --beldex-bg-header: #090b0d;
  --beldex-bg-chrome: #0a0a0a;
  --beldex-bg-tile: #1b1b1b;
  --beldex-panel: #111111;
  --beldex-panel-raised: #131313;
  --beldex-panel-sunken: #0e0e0e;
  --beldex-panel-glass: rgba(17, 17, 17, 0.2);
  --beldex-input-bg: rgba(26, 26, 26, 0.3);
  --beldex-input-bg-strong: rgba(26, 26, 26, 0.5);

  // Borders
  --beldex-border: #222222;
  // Same value as the design system's `border/tile`. Its `border/strong`
  // (focus / round buttons) is --beldex-border-focus.
  --beldex-border-strong: #333333;
  --beldex-border-focus: rgba(235, 235, 235, 0.2);
  --beldex-border-header: #1f2429;
  --beldex-border-input: #36343b;
  --beldex-divider: #2a2a2a;
  --beldex-hairline: rgba(235, 235, 235, 0.05);

  // Accent (green)
  --beldex-accent: #00bf0a;
  --beldex-accent-glow: #00ff41;
  --beldex-accent-tint: #0d1410;
  --beldex-accent-bg: rgba(0, 191, 10, 0.05);
  --beldex-accent-bg-strong: rgba(0, 191, 10, 0.1);
  --beldex-accent-border-soft: rgba(0, 191, 10, 0.2);
  --beldex-accent-border: rgba(0, 191, 10, 0.4);
  --beldex-accent-border-strong: rgba(0, 191, 10, 0.7);

  // Status (designer's Beldex Terminal design system v2, node 445:3).
  --beldex-danger: #f26666;
  --beldex-danger-wash: rgba(242, 102, 102, 0.06);
  --beldex-danger-border: rgba(242, 102, 102, 0.25);
  --beldex-danger-fill: #93000a;
  --beldex-warning: #fbbf24;
  --beldex-warning-strong: #fcd34d;
  --beldex-warning-wash: rgba(245, 158, 11, 0.06);
  --beldex-warning-border: rgba(245, 158, 11, 0.25);

  // Toast surfaces (Figma Toast component set, 524:2108).
  --beldex-toast-success-bg: #0f1a10;
  --beldex-toast-error-bg: #1a0f0f;
  --beldex-toast-warning-bg: #1a160c;
  --beldex-toast-info-border: rgba(235, 235, 235, 0.1);
  --beldex-shadow-toast: 0 12px 24px rgba(0, 0, 0, 0.5);

  // Text
  --beldex-text: #ebebeb;
  --beldex-text-strong: #ffffff;
  --beldex-text-muted: #737373;
  --beldex-text-subtle: #8d8d8d;
  --beldex-text-secondary: #acacac;
  --beldex-text-faint: #555555;
  --beldex-text-divider: #2c2c2c;
  --beldex-text-unit: #717882;

  // Primary (light) button
  --beldex-btn-primary-bg: #ebebeb;
  --beldex-btn-primary-text: #000000;

  // Typography (design system v2): Roboto Mono for UI, Inter for titles and
  // buttons, JetBrains Mono for small badges. Conthrax (display) is licensed
  // and not supplied yet, so display stays on Poppins-SemiBold.
  --beldex-font-mono: "Beldex Roboto Mono", "RobotoMono-Light", monospace;
  --beldex-font-sans: "Beldex Inter", "Poppins-Regular", sans-serif;
  --beldex-font-sans-medium: "Beldex Inter Medium", "Poppins-Medium", sans-serif;
  --beldex-font-micro: "Beldex JetBrains Mono", "Beldex Roboto Mono", monospace;
  --beldex-font-display: "Beldex Conthrax", "Poppins-SemiBold", sans-serif;

  --beldex-text-xs: 10px;
  --beldex-text-sm: 11px;
  --beldex-text-md: 12px;
  --beldex-text-base: 14px;
  --beldex-text-lg: 16px;
  --beldex-text-xl: 20px;

  // Spacing
  --beldex-space-1: 4px;
  --beldex-space-2: 8px;
  --beldex-space-3: 12px;
  --beldex-space-4: 16px;
  --beldex-space-5: 20px;
  --beldex-space-6: 24px;
  --beldex-space-7: 28px;
  --beldex-space-8: 36px;
  --beldex-space-9: 48px;

  // Shape. The design is square-cornered throughout.
  --beldex-radius-none: 0;
  --beldex-radius-sm: 2px;

  --beldex-shadow-panel: 0 24px 48px rgba(0, 0, 0, 0.6);
  --beldex-header-height: 56px;
  --beldex-transition: 120ms ease-out;
}

// ---------------------------------------------------------------------------
// Shared building blocks
// ---------------------------------------------------------------------------
// Every rule is scoped under `.beldex-app` (set on <body> in
// index.template.html), so portaled menus and dialogs are in scope too.
//
// Classes are BEM-style with a `beldex-` prefix. Pages compose them and don't
// redefine them; per-control interaction states live here.

// ---------------------------------------------------------------------------
// Surfaces: page background (Figma: #0b0b0b + radial vignette at 30% + 4px
// dot grid at 10%) on layouts, dialogs and menus.
// ---------------------------------------------------------------------------
.beldex-app .q-layout,
.beldex-app .beldex-dialog,
.beldex-app .beldex-menu,
.beldex-app .privacy-popup-menu {
  // Own stacking context so the dot layer (z-index -1) sits above the
  // background but under all content, without touching children's
  // positioning (q-header / q-menu are fixed/absolute).
  isolation: isolate;
  color: var(--beldex-text);
  font-family: var(--beldex-font-mono);
  background-color: var(--beldex-bg);
  background-image: radial-gradient(
    ellipse at center,
    rgba(34, 34, 34, 0.3) 0%,
    rgba(17, 17, 17, 0.3) 50%,
    rgba(8, 8, 8, 0.3) 75%,
    rgba(0, 0, 0, 0.3) 100%
  );
  background-attachment: fixed;

  &::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.1;
    background-image: url("~assets/icons/grid-dot.png");
    background-size: 4px 4px;
  }
}

// Pages rendered without a layout (404) sit straight on <body>.
body.beldex-app {
  background-color: var(--beldex-bg);
  color: var(--beldex-text);
}

.beldex-app {
  // Quasar paints the header in $primary; the base `.q-header .q-btn.menu`
  // rule positions the menu button absolutely.
  .q-header {
    height: auto;
    background: transparent;
    border-bottom: 0;
    box-shadow: none;
    color: inherit;

    .q-btn.menu {
      position: static;
      top: auto;
      width: auto;
      height: auto;
    }
  }

  // Scrollbars (over the base #646464 ones below).
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-track,
  ::-webkit-scrollbar-track-piece,
  ::-webkit-scrollbar-corner {
    background-color: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background-color: var(--beldex-border-strong);
    border-radius: 0;

    &:hover {
      background-color: var(--beldex-text-faint);
    }
  }

  ::selection {
    background: var(--beldex-accent-border);
  }

  // Visible keyboard focus ring for every control.
  :focus-visible {
    outline: 1px solid var(--beldex-accent);
    outline-offset: 2px;
  }

  // -------------------------------------------------------------------------
  // Top bar (frames 421:3316, 421:2005, 421:1768)
  // -------------------------------------------------------------------------
  .beldex-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--beldex-header-height);
    padding: 0 var(--beldex-space-5);
    background-color: var(--beldex-bg-header);
    border-bottom: 1px solid var(--beldex-border-header);

    &__brand {
      display: flex;
      align-items: center;
      gap: var(--beldex-space-3);
      min-width: 0;
    }

    &__logo-tile {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 24px;
      height: 24px;
      background-color: var(--beldex-accent-bg);
      border: 1px solid var(--beldex-accent);

      img {
        width: 14px;
        height: 16px;
        object-fit: cover;
      }
    }

    &__wordmark {
      font-family: var(--beldex-font-display);
      font-size: var(--beldex-text-base);
      line-height: 20px;
      letter-spacing: 0.7px;
      color: var(--beldex-text-strong);
      text-transform: uppercase;
      white-space: nowrap;
    }

    &__product {
      font-family: var(--beldex-font-sans);
      font-size: var(--beldex-text-base);
      line-height: 16px;
      letter-spacing: 1.2px;
      color: var(--beldex-text-subtle);
      text-transform: uppercase;
      white-space: nowrap;
    }

    &__actions {
      display: flex;
      align-items: center;
      gap: var(--beldex-space-2);
    }
  }

  // Network chip: "● MAINNET ACTIVE" (C8: other nets use the same style for
  // now).
  .beldex-net-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 20px;
    padding: 0 var(--beldex-space-2);
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-xs);
    line-height: 15px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--beldex-accent);
    background-color: var(--beldex-accent-bg-strong);
    border: 1px solid var(--beldex-accent-border-soft);

    &__dot {
      width: 6px;
      height: 6px;
      background-color: var(--beldex-accent);
      box-shadow: 0 0 6px var(--beldex-accent-glow);
    }
  }

  // Neutral count chip ("2 VAULTS").
  .beldex-chip {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 var(--beldex-space-2);
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-xs);
    line-height: 15px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--beldex-text-muted);
    background-color: rgba(235, 235, 235, 0.05);
    border: 1px solid rgba(235, 235, 235, 0.1);
  }

  // -------------------------------------------------------------------------
  // Stepper ("01 // CHOOSE LANGUAGE ——— 02 // CONFIGURATION SETTINGS")
  // -------------------------------------------------------------------------
  .beldex-stepper {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 670px;
    margin: 0 auto;
    padding: 0 var(--beldex-space-1);

    &__step {
      display: flex;
      align-items: center;
      gap: var(--beldex-space-2);
      flex: none;
      font-size: var(--beldex-text-base);
      line-height: 12px;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--beldex-text-muted);

      &--active {
        color: var(--beldex-text);
      }
    }

    &__marker {
      width: 6px;
      height: 6px;
      background-color: var(--beldex-text-muted);
    }

    // Stylus `&` expands to the whole parent chain, so these are spelled out.
    .beldex-stepper__step--active .beldex-stepper__marker {
      width: 8px;
      height: 8px;
      background-color: var(--beldex-accent);
    }

    .beldex-stepper__step--done .beldex-stepper__marker {
      background-color: var(--beldex-accent);
    }

    &__divider {
      flex: 1 1 auto;
      min-width: var(--beldex-space-4);
      height: 1px;
      margin: 0 var(--beldex-space-4);
      background-color: var(--beldex-divider);
    }
  }

  // -------------------------------------------------------------------------
  // Panels and headings
  // -------------------------------------------------------------------------
  .beldex-panel {
    background-color: var(--beldex-panel-glass);
    border: 1px solid var(--beldex-border);
    box-shadow: var(--beldex-shadow-panel);

    &--padded {
      padding: var(--beldex-space-7);
    }
  }

  // Outlined sub-section inside a panel (e.g. connection topology box).
  .beldex-section {
    border: 1px solid var(--beldex-border-strong);
    padding: var(--beldex-space-4) var(--beldex-space-5);
  }

  .beldex-heading {
    display: flex;
    align-items: center;
    gap: var(--beldex-space-3);

    &__title {
      margin: 0;
      font-family: var(--beldex-font-mono);
      font-weight: 700;
      font-size: var(--beldex-text-xl);
      line-height: 28px;
      color: var(--beldex-text-strong);
      text-transform: uppercase;
    }

    &__subtitle {
      margin: var(--beldex-space-1) 0 0;
      font-size: var(--beldex-text-sm);
      line-height: 16px;
      letter-spacing: 0.6px;
      color: var(--beldex-text-muted);
      text-transform: uppercase;
    }
  }

  // Small uppercase field/section label.
  .beldex-label {
    display: block;
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-md);
    line-height: 16px;
    letter-spacing: 0.6px;
    color: var(--beldex-text-muted);
    text-transform: uppercase;
  }

  .beldex-hint {
    display: flex;
    align-items: center;
    gap: var(--beldex-space-2);
    font-size: var(--beldex-text-sm);
    line-height: 16px;
    color: var(--beldex-text-muted);

    &--accent {
      color: var(--beldex-accent);
    }
  }

  .beldex-hr {
    height: 1px;
    width: 100%;
    border: 0;
    margin: 0;
    background-color: var(--beldex-hairline);
  }

  // -------------------------------------------------------------------------
  // Buttons. Apply to `q-btn` (unelevated, no-caps handled here) or <button>.
  // -------------------------------------------------------------------------
  .beldex-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--beldex-space-2);
    min-height: 40px;
    padding: 0 var(--beldex-space-8);
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-md);
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    color: var(--beldex-btn-primary-text);
    background-color: var(--beldex-btn-primary-bg);
    border: 1px solid var(--beldex-btn-primary-bg);
    border-radius: var(--beldex-radius-none);
    box-shadow: none;
    cursor: pointer;
    transition: background-color var(--beldex-transition), border-color var(--beldex-transition), color var(--beldex-transition);

    &:hover {
      background-color: var(--beldex-text-strong);
    }

    &--ghost {
      color: var(--beldex-text);
      background-color: var(--beldex-panel);
      border-color: var(--beldex-border);

      &:hover {
        background-color: var(--beldex-panel-raised);
        border-color: var(--beldex-border-strong);
      }
    }

    &[disabled],
    &.disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    // Quasar's .q-btn adds its own radius, shadow and hover overlay; beat
    // `.q-btn` / `.q-focus-helper` from quasar.styl.
    &.q-btn {
      border-radius: var(--beldex-radius-none) !important;

      &:before {
        box-shadow: none !important;
      }

      .q-focus-helper {
        display: none;
      }

      .q-btn__wrapper {
        padding: 0;
        min-height: 0;
      }

      .q-btn__content {
        gap: var(--beldex-space-2);
      }

      // `:label` text: beats the base `.q-btn__content .block { color #fff !important }`.
      .q-btn__content .block {
        color: inherit !important;
      }
    }
  }

  // Square icon button (back arrow, header gear).
  .beldex-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 28px;
    height: 28px;
    padding: 0;
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-lg);
    line-height: 1;
    color: var(--beldex-text-subtle);
    background-color: var(--beldex-panel);
    border: 1px solid var(--beldex-border);
    border-radius: var(--beldex-radius-none);
    cursor: pointer;
    transition: border-color var(--beldex-transition), color var(--beldex-transition);

    &:hover {
      color: var(--beldex-text);
      border-color: var(--beldex-border-strong);
    }

    &--bare {
      background-color: transparent;
      border-color: transparent;
    }

    &.q-btn {
      min-height: 0;
      border-radius: var(--beldex-radius-none) !important;

      .q-btn__wrapper {
        padding: 0;
        min-height: 0;
      }
    }
  }

  // Small square icon button in list rows (copy / QR / send).
  .beldex-square-btn {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    color: var(--beldex-text-muted);
    background-color: var(--beldex-panel);
    border: 1px solid rgba(235, 235, 235, 0.1);
    cursor: pointer;

    &:hover {
      color: var(--beldex-text);
    }

    &[disabled] {
      opacity: 0.5;
      cursor: not-allowed;
    }
  }

  // -------------------------------------------------------------------------
  // Form pages inside a panel (Advanced tabs, frames 421:16406 / 16591 /
  // 16781): description, stacked fields, right-aligned actions, result list.
  // -------------------------------------------------------------------------
  .beldex-form-desc {
    display: block;
    margin: var(--beldex-space-4) 0 var(--beldex-space-5);
    font-size: var(--beldex-text-md);
    line-height: 18px;
  }

  .beldex-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--beldex-space-3);
    margin-top: var(--beldex-space-6);
  }

  .beldex-box {
    display: flex;
    flex-direction: column;
    gap: var(--beldex-space-4);
    margin-bottom: var(--beldex-space-5);
    padding: var(--beldex-space-5);
    background-color: rgba(8, 8, 8, 0.8);
    border: 1px solid var(--beldex-hairline);

    &__title {
      margin: 0;
      font-family: var(--beldex-font-sans-medium);
      font-size: var(--beldex-text-base);
      font-weight: 400;
      color: var(--beldex-text);
    }

    &__row {
      display: flex;
      align-items: flex-end;
      gap: var(--beldex-space-3);
    }
  }

  .beldex-result {
    display: flex;
    flex-direction: column;
    margin-top: var(--beldex-space-5);

    &__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--beldex-space-4);
      min-height: 41px;
      padding: var(--beldex-space-3) 0;
      border-bottom: 1px solid var(--beldex-hairline);
    }

    &__value {
      font-size: var(--beldex-text-md);
      color: var(--beldex-text);
      text-align: right;
      word-break: break-all;

      &--good {
        color: var(--beldex-accent);
      }

      &--bad {
        color: var(--beldex-danger);
      }
    }
  }

  // -------------------------------------------------------------------------
  // Inputs. `--boxed`: dark field with full border (host select). Default:
  // translucent field with a bottom hairline (ports, log levels).
  // -------------------------------------------------------------------------
  .beldex-input {
    display: flex;
    align-items: center;
    min-height: 37px;
    padding: 0 10px 0 14px;
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-md);
    line-height: 16px;
    letter-spacing: 0.3px;
    color: var(--beldex-text-strong);
    background-color: var(--beldex-input-bg);
    border: 0;
    border-bottom: 1px solid var(--beldex-border);
    transition: border-color var(--beldex-transition);

    &:hover {
      border-color: var(--beldex-border-strong);
    }

    &:focus-within {
      border-color: var(--beldex-accent-border);
    }

    &--boxed {
      background-color: var(--beldex-bg);
      border: 1px solid var(--beldex-border);
    }

    &--error {
      border-color: var(--beldex-danger);
    }

    &__unit {
      flex: none;
      margin-left: var(--beldex-space-2);
      font-size: var(--beldex-text-xs);
      color: var(--beldex-text-unit);
    }

    // Trailing action segment ("Location" on storage paths).
    &__action {
      align-self: stretch;
      display: flex;
      align-items: center;
      margin: 0 -10px 0 var(--beldex-space-2);
      padding: 0 var(--beldex-space-4);
      font-size: var(--beldex-text-md);
      color: var(--beldex-text);
      background-color: var(--beldex-border);
      border: 0;
      border-left: 1px solid var(--beldex-border-header);
      cursor: pointer;
    }

    input,
    textarea {
      flex: 1 1 auto;
      min-width: 0;
      padding: 0;
      font: inherit;
      color: inherit;
      background: transparent;
      border: 0;
      outline: none;
    }
  }

  // -------------------------------------------------------------------------
  // BeldexField (components/beldex_field.vue): label
  // becomes .beldex-label, content becomes the underline input. Beats the
  // global `.beldex-field .content` base rules.
  // -------------------------------------------------------------------------
  .beldex-field {
    .label {
      margin: 0 0 var(--beldex-space-3);
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-md);
      line-height: 16px;
      letter-spacing: 0.6px;
      color: var(--beldex-text-muted);
      text-transform: uppercase;
    }

    .content {
      flex-wrap: nowrap;
      min-height: 37px;
      padding: 0 10px 0 14px;
      background: var(--beldex-input-bg);
      border: 0;
      border-bottom: 1px solid var(--beldex-border);
      border-radius: 0 !important; // beats the base `border-radius 10px !important`

      &.error {
        border-color: var(--beldex-danger);
      }
    }

    &:not(.disable):not(.disable-hover) .content:hover {
      background: var(--beldex-input-bg);
      border-color: var(--beldex-border-strong);
    }

    .content:focus-within {
      border-color: var(--beldex-accent-border);
    }

    &.disable {
      opacity: 0.5;

      .content {
        border-color: var(--beldex-border) !important; // beats the base .disable rule
      }
    }

    .error-label {
      margin-top: var(--beldex-space-1);
      font-size: var(--beldex-text-sm);
      color: var(--beldex-danger);
    }

    .q-field {
      margin: 0;
    }

    .q-field__control,
    .q-field__marginal {
      height: 36px;
      min-height: 36px;
    }

    .q-field__native,
    .q-field__input,
    .q-field__prefix,
    .q-field__suffix {
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-md);
      letter-spacing: 0.3px;
      color: var(--beldex-text-strong);
    }

    .q-field__native::placeholder {
      color: var(--beldex-text-faint);
    }

    .q-field__suffix {
      font-size: var(--beldex-text-xs);
      color: var(--beldex-text-unit);
    }

    // Trailing "Location"-style action segment.
    &--with-action .content {
      padding-right: 0;
      background: var(--beldex-input-bg-strong);
      border: 1px solid var(--beldex-border-input);

      > .q-btn {
        align-self: stretch;
        margin: 0;
        padding: 0 var(--beldex-space-4);
        font-family: var(--beldex-font-mono);
        font-size: var(--beldex-text-md) !important; // beats beldex_field.vue `.q-btn` 12px !important
        text-transform: none;
        color: var(--beldex-text) !important;
        background: var(--beldex-border) !important; // beats color="primary1"
        border-left: 1px solid var(--beldex-border-header);
        border-radius: 0;
        box-shadow: none;
      }
    }

    &--with-action:not(.disable):not(.disable-hover) .content:hover {
      background: var(--beldex-input-bg-strong);
    }
  }

  // Large centred input (create / restore / import, frames 421:2077, 421:2111).
  .beldex-field--hero {
    .content {
      min-height: 64px;
      padding: 0 10px;
      background: var(--beldex-bg);
    }

    &:not(.disable):not(.disable-hover) .content:hover {
      background: var(--beldex-bg);
    }

    .q-field__control,
    .q-field__marginal {
      height: 63px;
    }

    .q-field__native {
      font-size: var(--beldex-text-xl);
      font-weight: 300;
      text-align: center;
    }

    .q-field__native::placeholder {
      color: var(--beldex-text-faint);
    }
  }

  // -------------------------------------------------------------------------
  // Single-card form page (create / restore / import / created). Lives here
  // rather than in one page's style block because each page loads lazily.
  // -------------------------------------------------------------------------
  .beldex-form-page {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--beldex-space-9);

    &__card {
      display: flex;
      flex-direction: column;
      gap: 32px;
      width: 100%;
      max-width: 560px;
      padding: var(--beldex-space-7) 30px;
    }

    &__fields {
      display: flex;
      flex-direction: column;
      gap: var(--beldex-space-5);
    }

    &__actions {
      display: flex;
      justify-content: center;
      gap: var(--beldex-space-3);
      margin-top: -12px;
    }

    &__submit {
      padding: 0 29px;
      min-height: 46px;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: none;
      color: #000;
      background-color: var(--beldex-text-strong);
      border-color: var(--beldex-text-strong);

      img {
        width: 11px;
        height: 11px;
      }
    }
  }

  // -------------------------------------------------------------------------
  // Read-only value with a trailing Copy button (frame 421:3241)
  // -------------------------------------------------------------------------
  .beldex-copy-row {
    display: flex;
    align-items: stretch;
    min-height: 38px;
    padding-left: var(--beldex-space-3);
    background-color: var(--beldex-bg);
    border: 1px solid var(--beldex-border-input);

    &__value {
      flex: 1 1 auto;
      align-self: center;
      min-width: 0;
      padding: 10px var(--beldex-space-3) 10px 0;
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-md);
      line-height: 16px;
      letter-spacing: 0.3px;
      color: var(--beldex-text);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &--multiline .beldex-copy-row__value {
      line-height: 20px;
      white-space: normal;
      word-break: break-word;
    }

    &__btn {
      display: flex;
      flex: none;
      align-items: center;
      gap: 7px;
      align-self: flex-start;
      height: 36px;
      padding: 0 var(--beldex-space-4);
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-base);
      font-weight: 300;
      color: var(--beldex-accent);
      background-color: var(--beldex-panel);
      border: 0;
      border-left: 1px solid var(--beldex-border-header);
      cursor: pointer;

      &:hover {
        background-color: var(--beldex-panel-raised);
      }

      img {
        width: 16px;
        height: 16px;
      }
    }
  }

  // -------------------------------------------------------------------------
  // Collapsible section (q-expansion-item), "ADVANCED SETTINGS"
  // -------------------------------------------------------------------------
  .beldex-collapse,
  .beldex-collapse.q-expansion-item--expanded {
    border: 1px solid var(--beldex-border-header);
    background-color: rgba(11, 11, 11, 0.2); // beats the base --expanded #242433

    .q-item {
      min-height: 41px;
      padding: 12px 18px;
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-base);
      color: var(--beldex-text-strong);
      text-transform: uppercase;
      background-color: var(--beldex-panel);
      border-bottom: 1px solid var(--beldex-border);
    }

    .q-expansion-item__toggle-icon {
      color: var(--beldex-accent);
    }

    .q-expansion-item__content {
      padding: var(--beldex-space-5);
    }
  }

  // -------------------------------------------------------------------------
  // Segmented control (Send / Receive / Contacts, MN and BNS tabs)
  // -------------------------------------------------------------------------
  .beldex-segmented {
    display: inline-flex;
    gap: var(--beldex-space-1);
    height: 42px;
    padding: var(--beldex-space-1);
    background-color: rgba(8, 8, 8, 0.8);
    border: 1px solid rgba(235, 235, 235, 0.1);

    &__item {
      display: inline-flex;
      align-items: center;
      gap: var(--beldex-space-2);
      padding: 0 14px;
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-md);
      font-weight: 500;
      color: var(--beldex-text-muted);
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;

      &:hover {
        color: var(--beldex-text);
      }

      &--active {
        color: var(--beldex-text);
        background-color: rgba(235, 235, 235, 0.1);
        border-color: rgba(235, 235, 235, 0.1);
      }
    }

    &__dot {
      width: 6px;
      height: 6px;
      border-radius: 3px;
      background-color: var(--beldex-accent);
      box-shadow: 0 0 6px var(--beldex-accent-glow);
    }
  }

  // Filter tabs (Activity: All / Incoming / Outgoing)
  .beldex-filter-tabs {
    display: inline-flex;
    gap: 6px;

    &__item {
      height: 28px;
      padding: 0 var(--beldex-space-3);
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-md);
      color: var(--beldex-text-muted);
      background: transparent;
      border: 0;
      cursor: pointer;

      &:hover {
        color: var(--beldex-text);
      }

      &--active {
        font-weight: 500;
        color: #000;
        background-color: var(--beldex-btn-primary-bg);

        &:hover {
          color: #000;
        }
      }
    }
  }

  // -------------------------------------------------------------------------
  // Selectable option card (topology options, language cards, wallet mode)
  // with a square check marker.
  // -------------------------------------------------------------------------
  .beldex-option {
    display: flex;
    align-items: center;
    gap: var(--beldex-space-3);
    padding: 18px;
    text-align: left;
    color: var(--beldex-text);
    font-family: var(--beldex-font-mono);
    background-color: var(--beldex-panel);
    border: 1px solid var(--beldex-border);
    cursor: pointer;
    transition: border-color var(--beldex-transition), background-color var(--beldex-transition);

    &:hover {
      border-color: var(--beldex-border-strong);
    }

    &--active {
      background-color: var(--beldex-accent-tint);
      border-color: var(--beldex-accent-border-strong);

      &:hover {
        border-color: var(--beldex-accent);
      }
    }

    &[disabled],
    &--disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  }

  // Two-line option (title + hint), e.g. the Rescan dialog (frame 421:11595).
  .beldex-option__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .beldex-option__title {
    font-family: var(--beldex-font-sans-medium);
    font-size: var(--beldex-text-md);
    line-height: 16px;
    color: var(--beldex-text-strong);
  }

  .beldex-option__hint {
    font-size: var(--beldex-text-sm);
    line-height: 16px;
    color: var(--beldex-text-muted);
  }

  .beldex-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 14px;
    height: 14px;
    background-color: #000;
    border: 1px solid var(--beldex-text-muted);

    &--on {
      border-color: var(--beldex-accent);

      &::after {
        content: "";
        width: 6px;
        height: 6px;
        background-color: var(--beldex-accent);
      }
    }
  }

  // -------------------------------------------------------------------------
  // List row (wallet list) with monogram avatar
  // -------------------------------------------------------------------------
  .beldex-row {
    display: flex;
    align-items: center;
    gap: var(--beldex-space-4);
    width: 100%;
    min-height: 66px;
    padding: 14px var(--beldex-space-4);
    text-align: left;
    color: var(--beldex-text);
    background-color: var(--beldex-panel);
    border: 1px solid var(--beldex-border-strong);
    cursor: pointer;
    transition: border-color var(--beldex-transition), background-color var(--beldex-transition);

    &:hover,
    &--active {
      background-color: var(--beldex-accent-bg);
      border-color: var(--beldex-accent-border-soft);
      box-shadow: inset 2px 0 0 var(--beldex-accent);
    }
  }

  .beldex-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 36px;
    height: 36px;
    font-family: var(--beldex-font-mono);
    font-weight: 700;
    font-size: var(--beldex-text-md);
    color: var(--beldex-text);
    background-color: var(--beldex-panel);
    border: 1px solid rgba(235, 235, 235, 0.1);
    text-transform: uppercase;
  }

  .beldex-row:hover .beldex-avatar,
  .beldex-row--active .beldex-avatar {
    color: var(--beldex-accent);
    background-color: var(--beldex-accent-bg-strong);
    border-color: var(--beldex-accent-border-soft);
  }

  // Middle/end truncation helpers.
  .beldex-truncate {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  // -------------------------------------------------------------------------
  // Language cards (frame 421:3316 welcome, 421:2581 settings). Shared by
  // language_select.vue and language_select_settings.vue, so kept here
  // rather than in either component's lazily loaded style block.
  // -------------------------------------------------------------------------
  .language-select {
    display: flex;
    flex-direction: column;
    gap: var(--beldex-space-5);

    &__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--beldex-space-3);
    }

    &__card {
      justify-content: space-between;
      gap: var(--beldex-space-4);
      min-width: 0;
      padding: var(--beldex-space-4);
      background-color: var(--beldex-bg);
      border-color: var(--beldex-border-strong);

      &.beldex-option--active {
        background-color: var(--beldex-accent-tint);
        border-color: transparent;
        border-bottom-color: var(--beldex-accent-border-strong);
      }
    }

    &__flag {
      flex: none;
      width: 24px;
      height: 16px;
      background-size: cover;
      opacity: 0.6;
    }

    &__text {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      min-width: 0;
      margin-left: -2px;
    }

    &__index {
      font-size: var(--beldex-text-xs);
      line-height: 15px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: var(--beldex-text-muted);
    }

    &__name {
      font-family: var(--beldex-font-sans);
      font-size: var(--beldex-text-base);
      line-height: 28px;
      letter-spacing: 0.45px;
      color: var(--beldex-text-muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &__code {
      display: flex;
      align-items: center;
      flex: none;
      gap: var(--beldex-space-2);
      font-size: var(--beldex-text-md);
      line-height: 12px;
      letter-spacing: 0.6px;
      color: var(--beldex-text-muted);
    }

    &__marker {
      width: 6px;
      height: 6px;
      background-color: var(--beldex-border-strong);
    }

    .beldex-option--active {
      .language-select__flag {
        opacity: 1;
      }

      .language-select__index,
      .language-select__code {
        color: var(--beldex-accent);
      }

      .language-select__name {
        color: var(--beldex-text);
      }

      .language-select__marker {
        width: 8px;
        height: 8px;
        background-color: var(--beldex-accent);
      }
    }

    &__actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--beldex-space-4);
      background-color: var(--beldex-panel-sunken);
    }

    &__info {
      min-width: 0;
      padding-left: var(--beldex-space-3);
    }

    .beldex-btn img {
      width: 11px;
      height: 11px;
    }
  }

  // -------------------------------------------------------------------------
  // Dropdown menu (top-bar gear menu, frame 421:2005). Use on q-menu via
  // content-class="beldex-menu".
  // -------------------------------------------------------------------------
  .beldex-menu {
    min-width: 240px;
    padding: 0;
    background-color: var(--beldex-panel);
    border: 1px solid var(--beldex-border);
    border-radius: var(--beldex-radius-none);
    box-shadow: var(--beldex-shadow-panel);

    &::before {
      display: none;
    }


    .q-item {
      min-height: 48px;
      padding: var(--beldex-space-3) 22px;
      gap: var(--beldex-space-4);
      font-family: var(--beldex-font-sans);
      font-size: var(--beldex-text-lg);
      color: var(--beldex-text);
      border-left: 2px solid transparent;

      &:hover,
      &.q-manual-focusable--focused {
        background-color: var(--beldex-panel-glass);
        border-left-color: var(--beldex-text-muted);
      }
    }
  }

  // Swap "Privacy Swap" info popup. q-menu is portaled to <body>, so it needs
  // content-class="privacy-popup-menu" to pick these up.
  .privacy-popup-menu .privacy-popup {
    width: 330px;
    min-height: 0;
    padding: var(--beldex-space-4);
    gap: var(--beldex-space-3);
    background-color: var(--beldex-panel-raised);
    border: 1px solid var(--beldex-border);
    border-radius: var(--beldex-radius-none);
    box-shadow: var(--beldex-shadow-panel);

    .popup-content {
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-md);
      line-height: 1.5;
      color: var(--beldex-text-muted);
    }

    .close-btn {
      margin: 0;
      border-radius: var(--beldex-radius-none);
    }
  }
}

// Wallet menu dropdown (frame 421:4085): content-class adds
// `beldex-menu--wallet` to the base menu above.
.beldex-app .beldex-menu.beldex-menu--wallet {
  min-width: 220px;
  width: 220px;
  background-color: rgba(17, 17, 17, 0.92);
  backdrop-filter: blur(4px);
  border: 1px solid var(--beldex-border);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);

  .q-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 0;
  }

  .beldex-menu__head {
    box-sizing: border-box;
    height: 27px;
    min-height: 27px;
    // 22px = item padding (20px) + item border-left (2px), so the label
    // lines up with the item icons.
    padding: 8px 22px 0;
    font-family: var(--beldex-font-micro);
    font-size: 10px;
    letter-spacing: 0.5px;
    line-height: 15px;
    color: var(--beldex-text-faint);
    text-transform: uppercase;
  }

  .q-item {
    min-height: 36px;
    align-items: center;
    gap: 10px;
    padding: 0 20px;
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-md);
    letter-spacing: 0.3px;
    line-height: 16px;
    color: var(--beldex-text-muted);

    img {
      flex-shrink: 0;
      width: 14px;
      height: 14px;
    }

    // Hover/focus is drawn on the item itself; hide Quasar's overlay.
    .q-focus-helper {
      display: none;
    }

    &:hover,
    &.q-manual-focusable--focused {
      font-weight: 500;
      color: var(--beldex-text-strong);
      background-color: rgba(34, 34, 34, 0.6);
      border-left-color: var(--beldex-text-muted);
    }
  }

  .beldex-menu__sep {
    background-color: rgba(235, 235, 235, 0.1);
  }

  .q-item.wallet-settings__danger {
    color: #f26666;

    &:hover {
      color: #f26666;
    }
  }
}

// Compact dropdown for q-select popups (frame 421:4380 type filter):
// popup-content-class="beldex-menu beldex-menu--compact".
.beldex-app .beldex-menu.beldex-menu--compact {
  min-width: 160px;
  padding: 4px;
  background-color: var(--beldex-panel-sunken);
  background-image: none;

  .q-item {
    min-height: 36px;
    padding: 0 10px;
    align-items: center;
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-md);
    color: var(--beldex-text-muted);
    border-left: 0;
  }

  // Centre the label inside the row (the hover/selected fill is the row).
  .q-item__section {
    justify-content: center;
    padding: 0;
  }

  .q-item__label {
    margin: 0;
    padding: 0;
    line-height: 36px;
  }

  // beats app.styl `.q-menu * { color #fff }`
  .q-item * {
    color: inherit;
  }

  // Quasar's grey focus/hover wash.
  .q-focus-helper {
    display: none;
  }

  .q-item:hover,
  .q-manual-focusable--focused {
    color: var(--beldex-text);
    background-color: rgba(235, 235, 235, 0.03);
  }

  // Selected row: raised fill + green check.
  .q-item--active {
    color: var(--beldex-text);
    background-color: rgba(235, 235, 235, 0.05);

    &::after {
      content: "";
      flex: none;
      align-self: center;
      width: 12px;
      height: 12px;
      margin-left: auto;
      background-color: var(--beldex-accent);
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M1.5 6.2 4.6 9.2 10.5 3' fill='none' stroke='black' stroke-width='1.4'/></svg>");
      -webkit-mask-position: center;
      -webkit-mask-repeat: no-repeat;
      -webkit-mask-size: contain;
    }
  }
}

// Modal dialogs (Phase 3, frames 421:10705 / 421:13313 and siblings).
// On the q-card: class="beldex-dialog". Header = .beldex-dialog__head with an
// icon box, uppercase title and muted subtitle; footer = .beldex-dialog__actions.
// The scrim applies to every q-dialog, including ones without a beldex-dialog card.
.q-dialog > .q-dialog__backdrop {
  // Beats Quasar's rgba(0,0,0,.4) backdrop; blur per frame "Scrim".
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(1px);
}

.beldex-app .beldex-dialog {
  position: relative;
  width: 480px;
  max-width: 90vw;
  padding: 22px var(--beldex-space-7);
  background-color: var(--beldex-bg);
  border: 1px solid var(--beldex-border);
  border-radius: var(--beldex-radius-none);
  box-shadow: var(--beldex-shadow-panel);

  // Root's dot-grid layer is for pages, not dialogs.
  &::before {
    display: none;
  }

  .beldex-dialog__head {
    display: flex;
    align-items: center;
    gap: var(--beldex-space-4);
    min-height: 44px;
    padding-right: var(--beldex-space-6);
  }

  .beldex-dialog__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    background-color: var(--beldex-accent-bg);
    border: 1px solid var(--beldex-accent-border-soft);

    img {
      width: 18px;
      height: 18px;
    }

    .q-icon {
      color: var(--beldex-accent);
    }
  }

  .beldex-dialog__title {
    margin: 0;
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-lg);
    font-weight: 700;
    line-height: 22px;
    letter-spacing: -0.3px;
    color: var(--beldex-text-strong);
    text-transform: uppercase;
  }

  .beldex-dialog__subtitle {
    margin: var(--beldex-space-1) 0 0;
    font-size: var(--beldex-text-md);
    line-height: 18px;
    color: var(--beldex-text-muted);
  }

  .beldex-dialog__body {
    display: flex;
    flex-direction: column;
    gap: var(--beldex-space-5);
    margin-top: var(--beldex-space-5);
  }

  // Inset box for long values such as an address.
  .beldex-dialog__inset {
    padding: var(--beldex-space-3) var(--beldex-space-4);
    font-size: var(--beldex-text-sm);
    line-height: 18px;
    color: var(--beldex-text);
    word-break: break-all;
    background-color: rgba(8, 8, 8, 0.8);
    border: 1px solid rgba(235, 235, 235, 0.1);
  }

  // Key/value row: muted uppercase label left, value right.
  .beldex-dialog__kv {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--beldex-space-4);
    min-height: 41px;
    padding: var(--beldex-space-3) 0;
    font-size: var(--beldex-text-md);
    color: var(--beldex-text);
    border-bottom: 1px solid var(--beldex-hairline);

    &-label {
      font-size: var(--beldex-text-sm);
      letter-spacing: 0.6px;
      color: var(--beldex-text-muted);
      text-transform: uppercase;
    }

    &-value--strong {
      font-weight: 700;
    }
  }

  &.beldex-dialog--wide {
    width: 626px;
    max-height: 90vh;
    overflow-y: auto;
  }

  // Red warning strip (private keys, frame 421:10989).
  .beldex-dialog__warn {
    display: flex;
    align-items: center;
    gap: var(--beldex-space-4);
    padding: var(--beldex-space-4);
    font-size: var(--beldex-text-md);
    line-height: 17px;
    color: var(--beldex-danger);
    background-color: var(--beldex-danger-wash);
    border: 1px solid var(--beldex-danger-border);
  }

  // Inset value with a trailing Copy button.
  .beldex-dialog__inset--copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--beldex-space-4);
  }

  .beldex-dialog__inset-text {
    flex: 1 1 auto;
    min-width: 0;
    // Seed words wrap between words, keys/addresses anywhere.
    &--words {
      word-break: normal;
      overflow-wrap: anywhere;
    }
  }

  .beldex-dialog__copy.q-btn {
    flex: none;
    min-height: 0;
    padding: 0;
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-md);
    color: var(--beldex-text-muted);

    img {
      width: 12px;
      height: 12px;
      margin-right: var(--beldex-space-2);
    }
  }

  // QR tile: dark modules on a light ground, never inverted.
  .beldex-dialog__qr {
    align-self: center;
    padding: var(--beldex-space-4);
    line-height: 0;
    background-color: #fff;
  }

  .beldex-dialog__options {
    display: flex;
    flex-direction: column;
    gap: var(--beldex-space-2);
  }

  .beldex-dialog__browse.q-btn {
    align-self: stretch;
    padding: 0 var(--beldex-space-4);
    font-size: var(--beldex-text-md);
    font-weight: 700;
    color: var(--beldex-text);
    background-color: var(--beldex-panel);
    border-radius: var(--beldex-radius-none);
  }

  // Square close button in the top-right corner (frame 421:1826).
  .beldex-dialog__close {
    position: absolute;
    top: 9px;
    right: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity var(--beldex-transition);

    &:hover,
    &:focus-visible {
      opacity: 1;
    }
  }

  // Info note under a field (frame 421:1912).
  .beldex-dialog__note {
    display: flex;
    align-items: center;
    gap: var(--beldex-space-3);
    padding: var(--beldex-space-3) 14px;
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-sm);
    line-height: 17px;
    color: var(--beldex-text-muted);
    background-color: rgba(235, 235, 235, 0.05);
    border: 1px solid var(--beldex-border);

    img {
      flex: 0 0 auto;
    }
  }

  // Password prompt: field + show/hide toggle.
  &.unlock-dialog {
    width: 440px;

    .beldex-btn {
      font-family: var(--beldex-font-sans);
      font-weight: 600;
      text-transform: none;
      color: #000;

      img {
        width: 14px;
        height: 14px;
      }
    }
  }

  &.password-dialog {
    width: 480px;
  }

  // Confirm dialogs (Delete wallet / Restart / Exit / Delete contact / Discard).
  &.confirm-dialog {
    width: 480px;

    .beldex-dialog__subtitle {
      font-family: var(--beldex-font-mono);
      font-size: var(--beldex-text-md);
      line-height: 16px;
      color: var(--beldex-text-muted);
    }

    .confirm-dialog__warn {
      margin-top: var(--beldex-space-5);
    }

    .beldex-dialog__icon {
      color: var(--beldex-text-muted);
      background-color: rgba(235, 235, 235, 0.05);
      border-color: var(--beldex-border);
    }

    .confirm-dialog__icon--danger {
      color: var(--beldex-danger);
      background-color: var(--beldex-danger-wash);
      border-color: var(--beldex-danger-border);
    }

    .confirm-dialog__icon--accent {
      color: var(--beldex-accent);
      background-color: var(--beldex-accent-bg);
      border-color: var(--beldex-accent-border-soft);
    }

    // Monochrome SVG tinted with the surrounding text colour.
    .confirm-dialog__ico {
      display: inline-block;
      width: 18px;
      height: 18px;
      background-color: currentColor;
      mask: var(--ico) center / contain no-repeat;
      -webkit-mask: var(--ico) center / contain no-repeat;
    }

    .confirm-dialog__ico--btn {
      width: 14px;
      height: 14px;
    }

    .beldex-btn.confirm-dialog__ok--danger {
      color: var(--beldex-danger);
      background-color: rgba(220, 38, 38, 0.15);
      border-color: var(--beldex-danger-border);

      &:hover {
        background-color: rgba(220, 38, 38, 0.25);
      }
    }
  }

  .unlock-dialog__subtitle {
    font-family: var(--beldex-font-mono);
    font-size: var(--beldex-text-sm);
    line-height: 16px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .unlock-dialog__input {
    min-height: 41px;
    padding: 0 0 0 10px;
  }

  .unlock-dialog__field {
    flex: 1 1 auto;
    min-width: 0;
    height: 40px;
    padding: 0;
    font: inherit;
    font-weight: 300;
    letter-spacing: 0.3px;
    color: var(--beldex-text-strong);
    background: transparent;
    border: 0;
    outline: none;

    &::placeholder {
      color: var(--beldex-text-faint);
    }
  }

  .unlock-dialog__reveal {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;

    &:focus-visible {
      outline: 1px solid var(--beldex-accent-border);
    }
  }

  .beldex-dialog__actions {
    display: flex;
    gap: var(--beldex-space-3);
    margin-top: var(--beldex-space-5);

    // Frames 30-38: dialog buttons are Inter semibold, mixed case.
    .beldex-btn {
      font-family: var(--beldex-font-sans);
      font-weight: 600;
      text-transform: none;
    }

    > .q-btn,
    > .beldex-btn {
      flex: 1 1 0;
    }
  }
}

// Motion respects the OS setting.
@media (prefers-reduced-motion: reduce) {
  .beldex-app,
  .beldex-app * {
    transition: none !important;
    animation: none !important;
  }
}

// Date picker (restore / import-view-only "refresh from date"). q-popup-proxy
// is portaled to <body>, so this is keyed on the q-date's own class and reads
// the :root tokens rather than sitting under `.beldex-app`.
.q-date.beldex-date
  background-color var(--beldex-panel-raised)
  border 1px solid var(--beldex-border)
  border-radius var(--beldex-radius-none)
  box-shadow var(--beldex-shadow-panel)
  color var(--beldex-text)
  font-family var(--beldex-font-mono)

  .q-date__header
    background-color var(--beldex-panel-sunken)
    border-bottom 1px solid var(--beldex-border)
    border-radius var(--beldex-radius-none)
    color var(--beldex-text)

  .q-date__header-subtitle
    font-family var(--beldex-font-mono)
    color var(--beldex-text-muted)

  .q-date__header-title-label
    font-family var(--beldex-font-sans)
    color var(--beldex-text-strong)

  .q-date__view
    font-family var(--beldex-font-mono)

  .q-date__navigation .q-btn
    font-family var(--beldex-font-sans)
    color var(--beldex-text)

  .q-date__calendar-weekdays > div
    font-family var(--beldex-font-mono)
    color var(--beldex-text-muted)

  .q-date__calendar-days > div
    font-family var(--beldex-font-mono)
    color var(--beldex-text)

  .q-date__calendar-item--out
    color var(--beldex-text-faint)

  .q-date__calendar-item--fill
    visibility hidden

  .q-date__calendar-item button
    font-family var(--beldex-font-mono)
    border-radius var(--beldex-radius-none)

  .q-date__calendar-item button:hover
    background-color var(--beldex-accent-bg-strong) !important

  .q-date__calendar-item button.bg-primary
    background-color var(--beldex-accent) !important
    color var(--beldex-text-strong)

  .q-date__calendar-item--out button
    color var(--beldex-text-faint)

  .q-date__calendar-item--out + div
    color var(--beldex-text-faint)

  .q-date__years-item .q-btn,
  .q-date__months-item .q-btn
    font-family var(--beldex-font-mono)
    border-radius var(--beldex-radius-none)

  .q-date__actions .q-btn
    font-family var(--beldex-font-sans)
    color var(--beldex-text) !important
    border-radius var(--beldex-radius-none)

  .q-date__actions .q-btn:hover
    background-color var(--beldex-accent-bg-strong) !important

// Toasts (Figma Toast component set 524:2108: Compact 524:2119, Detailed
// 524:2145). The classes come from the notify types registered in
// boot/notify.js. A toast with a caption is the Detailed size.
// Stack sits 24px in from the bottom-right corner, 8px between toasts.
.beldex-app .q-notifications__list--bottom
  margin-bottom: 24px

.q-notification.beldex-toast
  --beldex-toast-accent: var(--beldex-accent)
  --beldex-toast-action: var(--beldex-accent)
  min-height: 0
  margin: 8px 24px 0
  padding: 12px 14px

  // Quasar pins a leaving toast at its measured inline `left`, which only
  // lines up with zero side margins (as Quasar's own rule sets).
  &[class*="-leave-active"]
    margin-left: 0
    margin-right: 0
  background-color: var(--beldex-panel)
  border: 1px solid var(--beldex-toast-info-border)
  border-radius: var(--beldex-radius-none)
  box-shadow: var(--beldex-shadow-toast)
  color: var(--beldex-text-secondary)
  font-family: var(--beldex-font-mono)
  font-size: var(--beldex-text-md)

  .q-notification__icon
    position: relative
    flex: 0 0 16px
    width: 16px
    height: 16px
    margin-right: 10px

    // Glyphs keep their own size inside the 16px icon frame.
    img
      position: absolute
      top: 1.33px
      left: 1.33px
      width: auto
      height: auto

  .q-notification__message
    padding: 0
    font-weight: 500
    line-height: 16px

  .q-notification__actions
    padding: 0 0 0 10px
    margin: 0
    gap: 16px

    .q-btn
      min-height: 0
      padding: 0
      color: var(--beldex-toast-action)
      font-family: var(--beldex-font-mono)
      font-size: var(--beldex-text-sm)
      font-weight: 700
      line-height: 16px
      letter-spacing: 0.6px
      text-transform: uppercase

      .q-btn__wrapper
        min-height: 0
        padding: 0

      .q-focus-helper
        display: none

    .q-btn.beldex-toast__dismiss
      color: var(--beldex-text-muted)

  // Leave the toast's own `position` alone: Quasar pins a leaving toast with
  // an inline `left`, which would shift a relatively positioned one sideways.
  // The bar is placed against the (relative) wrapper instead, reaching past
  // the padding to the border edge.
  .q-notification__progress
    z-index: 1
    left: -15px
    right: -15px
    bottom: -13px
    height: 2px
    background: var(--beldex-toast-accent)
    opacity: 0.6
    border-radius: var(--beldex-radius-none)

  // Detailed: title + description, actions below them.
  &:has(.q-notification__caption)
    width: 380px
    max-width: 95vw
    padding: 14px 14px 16px 16px

    .q-notification__wrapper
      flex-direction: column
      align-items: stretch

    .q-notification__content
      align-items: flex-start

    .q-notification__icon
      margin-right: 12px

    .q-notification__message > div:first-child
      color: var(--beldex-text)
      font-family: var(--beldex-font-sans)
      font-size: 13px
      font-weight: 600
      line-height: 18px

    .q-notification__caption
      margin-top: 4px
      color: var(--beldex-text-subtle)
      font-size: var(--beldex-text-md)
      font-weight: 400
      line-height: 18px
      opacity: 1

    .q-notification__actions
      justify-content: flex-start
      padding: 12px 0 0 28px

    .q-notification__progress
      left: -17px
      bottom: -17px

  &--success
    background-color: var(--beldex-toast-success-bg)
    border-color: var(--beldex-accent-border-soft)

  &--error
    --beldex-toast-accent: var(--beldex-danger)
    --beldex-toast-action: var(--beldex-text)
    background-color: var(--beldex-toast-error-bg)
    border-color: var(--beldex-danger-border)

  &--warning
    --beldex-toast-accent: #f59e0b
    --beldex-toast-action: var(--beldex-text)
    background-color: var(--beldex-toast-warning-bg)
    border-color: var(--beldex-warning-border)

  &--error,
  &--warning
    .q-notification__icon img
      top: 1.34px
      left: 0.74px

  &--info
    --beldex-toast-accent: var(--beldex-text)

    .q-notification__icon img
      top: 2px
      left: 1.33px

// ---------------------------------------------------------------------------
// Base rules: Quasar defaults and shared app styles the components above
// build on (scrollbars, buttons, swap/history tables, $q.dialog plugin, …).
// ---------------------------------------------------------------------------
@font-face {
  font-family: "RobotoMono-Light";
  src: url("themes/RobotoMono-Light.ttf");
}

*::-webkit-scrollbar {
  width: 4px;
  height: 8px;
}
*::-webkit-scrollbar-button {
  background-color: #646464;
  height: 0;
  width: 0;
}
*::-webkit-scrollbar-thumb {
  height: 50px;
  background-color: #646464;
  border-radius: 3px;
}
*::-webkit-resizer {
  background-color: #646464;
}
h1,
h2,
h3,
h4,
h5,
h6,
img,
.q-list-header,
.q-header,
.q-menu .q-item-label,
.q-list-link .q-item,
.q-checkbox .q-option-label,
.infoBox .text,
.modal-header,
footer {
  -webkit-user-select: none !important;
  -moz-user-select: none !important;
  -ms-user-select: none !important;
  user-select: none !important;
}
.break-all {
  word-break: break-all;
}
.ellipsis {
  text-overflow: ellipsis;
  overflow: hidden;
}
.uppercase {
  text-transform: uppercase;
}
.q-field {
  margin: 20px 0;
}
.q-field.q-ma-none {
  margin: 0;
}
.q-inner-loading {
  z-index: 2;
  // Same scrim as the full-screen loader (Figma "Scrim" 571:2298).
  background-color: rgba(0, 0, 0, 0.72);
  -webkit-backdrop-filter: blur(5px);
  backdrop-filter: blur(5px);
}
.q-btn {
  text-transform: none;
}
.submit-button {
  margin-top: 35px;
}
.q-expansion-item {
  background-color: #32324a;
  border-radius: 10px;
}
.q-expansion-item--expanded {
